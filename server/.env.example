
# Application
NODE_ENV=development
PORT=5005

# Frontend URLs
CLIENT_URL=http://localhost:3005
ALLOWED_CLIENT_URLS=http://localhost:3005

# Email
RESEND_API_KEY=your_resend_api_key
APP_EMAIL=your_verified_sender_email

# Database and Redis
MONGO_URI=your_mongodb_connection_string
REDIS_URL=your_redis_connection_url

# JWT Authentication
JWT_ACCESS_SECRET=your_access_token_secret
JWT_REFRESH_SECRET=your_refresh_token_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_TTL_SECONDS=604800
ACCESS_TOKEN_COOKIE_MAX_AGE=900000
REFRESH_TOKEN_COOKIE_MAX_AGE=604800000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5005/api/v1/auth/google/callback
